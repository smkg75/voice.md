# The setup's working directory, wherever someone points it. It holds raw mail
# between the collection and the profile, and the skill deletes it at the end;
# this is the second lock, in case a run stops in the middle.
voice-setup/
*.mbox
samples/
stats/

# What a replay of the example downloads. The corpus is public domain and is
